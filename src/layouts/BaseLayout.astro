---
import '../styles/global.css'
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { pageTitle } = Astro.props;
const tabTitle = pageTitle === "Home" ? "Ryo-suke.org" : `${pageTitle} | Ryo-suke.org`;
---



<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/umekabuto.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<script src="https://kit.fontawesome.com/c8d155ce04.js" crossorigin="anonymous"></script>
		<title>{tabTitle}</title>
	</head>
	<body>
		<Header />
		<slot name="hero" />
		<main class="w-wrap">
			<slot />
		</main>
		
		<Footer />
		<script>
			import "../scripts/menu.js";
		</script>
		
	</body>
	
</html>
