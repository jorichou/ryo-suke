---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
const { frontmatter } = Astro.props;
const formattedDate = new Date(frontmatter.pubDate)
    .toLocaleDateString("ja-JP", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
    })
    .replace(/\//g, ".");
---

<BaseLayout pageTitle={frontmatter.title}>
    <div class="news-container">
        <Breadcrumbs title={frontmatter.title} />
        <div class="news-top">
            <h1 class="post-title">{frontmatter.title}</h1>
            <p class="post-date">{formattedDate}</p>
            <!-- <p class="description">{frontmatter.description}</p> -->
        </div>
        <article>
            <slot />
        </article>
    </div>
    <!-- 
    <div class="tags">{
        frontmatter.tags.map((tag) => (
            <p class="tag"><a href={`/tags/${tag}`}>{tag}</a></p>
        ))}
    </div>
    <slot /> -->
</BaseLayout>
<style>

    .news-top {
        margin-bottom: 2rem;
        display: grid;
        grid-template-columns: 1fr;
        grid-template-rows: 1fr;
        gap: 1rem;
    }

    .post-date {
        margin: 0;
        font-weight: var(--font-weight-normal);
        color: var(--main-color-black);
    }

    html.dark .post-date {
        color: var(--main-color-white);
    }

    .post-title {
        color: var(--main-color-black); 
        font-weight: var(--font-weight-bold);
        margin: 0;
    }

    html.dark .post-title {
        color: var(--main-color-white);
    }

    .news-container {
        display: flex;
        flex-direction: column;
        padding: 7vh 5vw;
    }

    .description {
        margin: 0;
    }
    
    a {
        color: #00539f;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
    }

    .tag {
        margin: 0.25rem;
        border: dotted 1px #a1a1a1;
        border-radius: .5rem;
        padding: .5rem 1rem;
        font-size: 1.15rem;
        background-color: #f8fcfd;
    }

    /* 節（h2）および小節（h3, h4）のスペーシング */
    article :global(h2) {
        color: var(--main-color-black);
        font-weight: var(--font-weight-semibold);
        margin-top: 4rem;
        margin-bottom: 1.5rem;
        font-size: 1.6rem;
    }

    article :global(h2:first-of-type) {
        margin-top: 1.5rem;
    }

    /* 小節（h3）の間隔 */
    article :global(h3) {
        color: var(--main-color-black);
        font-weight: var(--font-weight-semibold);
        margin-top: 3.5rem;
        margin-bottom: 1.2rem;
        font-size: 1.3rem;
    }

    /* 節（h2）直後の小節（h3）の間隔調整 */
    article :global(h2 + h3) {
        margin-top: 1.5rem;
    }

    article :global(h4) {
        color: var(--main-color-black);
        font-weight: var(--font-weight-semibold);
        margin-top: 2.5rem;
        margin-bottom: 0.8rem;
    }

    article :global(p) {
        margin: 1.2rem 0;
        line-height: 1.8;
        font-weight: var(--font-weight-normal);
    }

    html.dark article :global(h2) {
        color: var(--main-color-white);
    }

    html.dark article :global(h3) {
        color: var(--main-color-white);
    }

    html.dark article :global(h4) {
        color: var(--main-color-white);
    }

    html.dark article :global(p) {
        color: var(--main-color-white);
    }
</style>