---
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Tag from "../components/Tag.astro";
const { frontmatter, headings } = Astro.props;
const formattedDate = new Date(frontmatter.pubDate)
    .toLocaleDateString("ja-JP", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
    });
---

<BaseLayout pageTitle={frontmatter.title}>
    <!-- <div class="post-layout"> -->
    <div class="post-container">
        <Breadcrumbs title={frontmatter.title} />
        <div class="post-top">
            <div class="img-container">
                <img
                src={frontmatter.image.url}
                alt={frontmatter.image.alt}
                />
            </div>
            <h1 class="post-title">{frontmatter.title}</h1>
            <div class="post-meta">
                <p class="post-date">{formattedDate}</p>
                <Tag tagName={frontmatter.janre} />
            </div>
            <p class="description">{frontmatter.description}</p>
        </div>
        <article>
            <slot />
        </article>
    </div>
        <!-- <aside>
            <TableOfContents headings={headings} />
        </aside> -->
    <!-- </div> -->
</BaseLayout>
<style>
    .post-meta {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        margin: 1.2rem 0 2.8rem 0;

    }

    .post-date {
        margin: 0;
        font-weight: var(--font-weight-normal);
        color: var(--main-color-black);
    }
    .post-title {
        color: var(--main-color-black);
        margin: 2rem 0 0 0;
    }

    html.dark .post-date {
        color: var(--main-color-white);
    }

    html.dark .post-title {
        color: var(--main-color-white);
    }

    .post-container {
        display: flex;
        flex-direction: column;
        padding: 7vh 5vw;
    }

    .img-container {
        /* background-color: #f0f0f0; Placeholder color */
        margin: 2vh 0 2rem auto;
        display: flex;
        justify-content: center;
    }

    .img-container img {
        aspect-ratio: 16 / 9; /* Sets a 4:3 aspect ratio */

        width: 60%;
        height: auto;
        object-fit: cover; /* This makes the image cover the container, cropping it */
        border-radius: 20px;
        border: 1px var(--main-color-black) solid;
        margin: 0;
    }

    html.dark .img-container img {
        border: 1px var(--main-color-white) solid;
    }

    article {
        width: 100%;
        overflow-x: auto;
    }

    /* 節（h2）および小節（h3, h4）のスペーシング */
    article :global(h2) {
        color: var(--main-color-black);
        font-weight: var(--font-weight-semibold);
        margin-top: 4rem;
        margin-bottom: 1.5rem;
        font-size: 1.6rem;
    }

    article :global(h2:first-of-type) {
        margin-top: 1.5rem;
    }

    /* 小節（h3）の間隔 */
    article :global(h3) {
        color: var(--main-color-black);
        font-weight: var(--font-weight-semibold);
        margin-top: 3.5rem;
        margin-bottom: 1.2rem;
        font-size: 1.3rem;
    }

    /* 節（h2）直後の小節（h3）の間隔調整 */
    article :global(h2 + h3) {
        margin-top: 1.5rem;
    }

    article :global(h4) {
        color: var(--main-color-black);
        font-weight: var(--font-weight-semibold);
        margin-top: 2.5rem;
        margin-bottom: 0.8rem;
    }

    article :global(p) {
        margin: 1.2rem 0;
        line-height: 1.8;
    }

    html.dark article :global(h2) {
        color: var(--main-color-white);
    }

    html.dark article :global(h3) {
        color: var(--main-color-white);
    }

    html.dark article :global(h4) {
        color: var(--main-color-white);
    }

    html.dark article :global(p) {
        color: var(--main-color-white);
    }

    /* 表（テーブル）スタイル */
    article :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin: 2.5rem 0;
        font-size: 0.95rem;
        line-height: 1.6;
        border-top: 1.5px solid var(--theme-color);
        border-bottom: 1.5px solid var(--theme-color);
        border-left: none;
        border-right: none;
    }

    article :global(thead) {
        background-color: rgba(232, 107, 121, 0.06);
    }

    article :global(th),
    article :global(td) {
        padding: 0.85rem 1.2rem;
        border-top: none;
        border-left: none;
        border-right: none;
        border-bottom: 1px solid #e0e0e0;
        text-align: left;
    }

    /* 列タイトル (thead th) */
    article :global(th) {
        color: var(--theme-color);
        font-weight: var(--font-weight-semibold);
        border-bottom: 1.5px solid var(--theme-color);
        letter-spacing: 0.02em;
    }

    /* 行タイトル (tbody th, tbody tr の先頭セル) */
    article :global(tbody th),
    article :global(tbody tr > th:first-child),
    article :global(tbody tr > td:first-child) {
        font-weight: var(--font-weight-semibold);
        color: var(--main-color-black);
    }

    article :global(td) {
        color: var(--main-color-black);
        font-weight: var(--font-weight-normal);
    }

    /* 最下行のセルの下線はテーブル下部境界線と重複しないように消去 */
    article :global(tbody tr:last-child td),
    article :global(tbody tr:last-child th) {
        border-bottom: none;
    }

    /* 行ホバー時のアクセント */
    /* article :global(tbody tr) {
        transition: background-color 0.2s ease;
    }

    article :global(tbody tr:hover) {
        background-color: rgba(232, 107, 121, 0.04);
    } */

    /* Markdownのセル配置指定（左寄せ・中央・右寄せ）を尊重 */
    article :global(th[align="left"]),
    article :global(td[align="left"]) {
        text-align: left;
    }

    article :global(th[align="center"]),
    article :global(td[align="center"]) {
        text-align: center;
    }

    article :global(th[align="right"]),
    article :global(td[align="right"]) {
        text-align: right;
    }

    /* スマホ画面対応 */
    @media screen and (max-width: 636px) {
        .img-container img {
            width: 100%;
        }

        article :global(h2) {
            margin-top: 2.8rem;
            margin-bottom: 1rem;
            font-size: 1.3rem;
        }

        article :global(h3) {
            margin-top: 2.5rem;
            margin-bottom: 0.8rem;
            font-size: 1.1rem;
        }

        article :global(h2 + h3) {
            margin-top: 1.2rem;
        }

        article :global(table) {
            font-size: 0.85rem;
            margin: 1.5rem 0;
        }

        article :global(th),
        article :global(td) {
            padding: 0.65rem 0.75rem;
        }
    }

    /* ダークモード対応 */
    :global(html.dark) article :global(table) {
        border-top-color: var(--theme-color-dark);
        border-bottom-color: var(--theme-color-dark);
    }

    :global(html.dark) article :global(thead) {
        background-color: rgba(232, 107, 121, 0.15);
    }

    :global(html.dark) article :global(th) {
        border-bottom-color: var(--theme-color-dark);
        color: var(--theme-color-dark);
    }

    :global(html.dark) article :global(td) {
        color: var(--main-color-white);
        border-bottom-color: rgba(255, 255, 255, 0.12);
    }

    :global(html.dark) article :global(tbody th),
    :global(html.dark) article :global(tbody tr > th:first-child),
    :global(html.dark) article :global(tbody tr > td:first-child) {
        color: var(--main-color-white);
    }

    /* :global(html.dark) article :global(tbody tr:hover) {
        background-color: rgba(232, 107, 121, 0.1);
    } */
</style>
