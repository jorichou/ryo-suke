---
const {itemIcon, itemName, itemDetail} = Astro.props;
---

<li class="skill-item">
    <button
        type="button" 
        class="card-btn"
        data-name={itemName}
        data-icon={itemIcon}
        data-detail={itemDetail}
    >
        <div class="item-icon">
            <img src={itemIcon} alt={itemName} class="icon-img" />
        </div>
        <div class="item-name">
            <p>{itemName}</p>
        </div>
    </button>
</li>

<style>
    li {
        list-style: none;
        width: fit-content;
        margin: 0;
        padding: 0;
        width: 100%;

    }

    .card-btn{
        all: unset;
        box-sizing: border-box;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        background-color: var(--main-color-white);
        gap: 1rem;
        border: solid 1px var(--main-color-black);
        border-radius: 10px;
        /* padding: 1.2rem 1rem 0.8rem 1rem; */
        padding: 0.5rem;
        height: auto;
        width: 100%;
        aspect-ratio: 1 / 1;
        outline: 1.5px solid transparent;
        transition: border-color 0.25s ease, outline 0.25s ease;
        /* aspect-ratio: 5 / 4; */
    }

    .card-btn:hover {
        border: 1px solid var(--theme-color);
        outline: 1.5px solid var(--theme-color);
    }

    .item-icon {
        /* padding: 2rem; */
        display: flex;
        align-items: center;
        justify-content: center;
        height: 8vh;
        width: 8vh;
        
    }

    .icon-img{
        max-width: 80%;
        max-height: 80%;
        width: auto;
        height: auto;
        object-fit: contain;
    }

    .item-name {
        margin: 0;
        padding: 0;
    }

    .item-name p {
        margin: 0;
        font-size: 1rem;
        font-weight: var(--font-weight-normal);
    }

    @media screen and (max-width: 768px) {
        .card{
            border-radius: 20%;
        }
    }
</style>