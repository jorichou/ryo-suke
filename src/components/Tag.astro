---
const { tagName } = Astro.props;
---

<div class="content-tag">
    <p>{tagName}</p>
</div>



<style>
    .content-tag {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: clamp(24px, 2.5vh, 48px);
        padding: 0.25rem 0.75rem;
        border-radius: 50px;
        border: 1px solid #212121;
        background-color: #f5f5f5;
        /* color: #212121; */
        font-size: 0.875rem;
        font-weight: 400;
        width: fit-content;
    }

    .content-tag p {
        color: #212121;
        font-size: 0.7rem;
        margin: 0;
    }

    html.dark .content-tag {
        border: 1px solid #f5f5f5;
        background-color: #212121;
    }

    html.dark .content-tag p {
        color: #f5f5f5;
    }
</style>