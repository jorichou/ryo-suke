---
const slideImages = [
    "/images/hero-slide/240629165501671.JPG",
    "/images/hero-slide/250213091942541.JPG",
    "/images/hero-slide/250525131335388.JPG",
    "/images/hero-slide/251102162009288.JPG",
    "/images/hero-slide/260614194404856.JPG",
];
---

<style>
    .hero {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        /* background-color: white; */
        height: clamp(400px, 50vh, 600px);
        max-height: 800px;
        width: 100%;
    }

    .bg-slide {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
    }

    .bg-slide::after {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        width: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 2;
    }

    .slide-item {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        transition: opacity 1.5s ease-in-out;
        z-index: 1;
    }

    .slide-item.active {
        opacity: 1;
    }

    .slide-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .hero-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 10;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        padding: 0 20px;
        box-sizing: border-box;
        pointer-events: none;
    }

    .input-box {
        display: inline-flex;
        align-items: center;
        /* background: rgba(0, 0, 0, 0.45); */
        /* backdrop-filter: blur(8px); */
        /* -webkit-backdrop-filter: blur(8px); */
        /* border: 1px solid rgba(255, 255, 255, 0.3); */
        /* border-radius: 12px; */
        /* padding: 14px 28px; */
        /* box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37); */
        /* max-width: 90%; */
    }

    .typing-text {
        color: #ffffff;
        font-size: clamp(1.5rem, 5vw, 3rem);
        font-family:
            "Google Sans Flex", "Noto Sans", "Consolas", "Courier New", Courier,
            monospace;
        font-weight: 600;
        letter-spacing: 0.1em;
        white-space: pre;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
    }
    
    /* @media screen and (max-width: 636px) {
        .typing-text {
            font-size: clamp(1.0rem, 1.5vw, 2rem);
        }
    } */

    .typing-cursor {
        display: inline-block;
        width: 2px;
        height: 1.2em;
        background-color: #ffffff;
        margin-left: 4px;
        animation: blink 0.8s infinite;
        vertical-align: middle;
    }

    @keyframes blink {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0;
        }
    }

    @media screen and (min-width: 636px) {
        .hero {
            height: clamp(600px, 60vh, 800px);
            width: 100%;
            margin-bottom: 10vh;
        }
    }
</style>

<div class="hero">
    <div class="bg-slide">
        {
            slideImages.map((src, index) => (
                <div class={`slide-item ${index === 0 ? "active" : ""}`}>
                    <img
                        src={src}
                        alt={`ヒーロースライド画像 ${index + 1}`}
                        loading={index === 0 ? "eager" : "lazy"}
                    />
                </div>
            ))
        }
    </div>
    <div class="hero-content">
        <div class="input-box">
            <span id="typing-text" class="typing-text"></span><span
                class="typing-cursor"></span>
        </div>
    </div>
</div>

<script>
    function initHero() {
        const typingTextEl = document.getElementById("typing-text");
        if (!typingTextEl) return;

        // タイピング初期化
        typingTextEl.textContent = "";

        // スライドショー初期化
        const slides = document.querySelectorAll(".bg-slide .slide-item");
        if (slides.length > 1) {
            let currentIndex = Array.from(slides).findIndex((s) =>
                s.classList.contains("active"),
            );
            if (currentIndex < 0) currentIndex = 0;

            if ((window as any).__heroSlideInterval) {
                clearInterval((window as any).__heroSlideInterval);
            }
            (window as any).__heroSlideInterval = setInterval(() => {
                slides[currentIndex].classList.remove("active");
                currentIndex = (currentIndex + 1) % slides.length;
                slides[currentIndex].classList.add("active");
            }, 5000);
        }

        // タイピングエフェクト
        const fullText = "This is Ryousuke's site.";
        let charIndex = 0;
        const typingSpeed = 90; // ミリ秒単位

        if ((window as any).__heroTypingTimeout) {
            clearTimeout((window as any).__heroTypingTimeout);
        }

        function typeChar() {
            if (charIndex < fullText.length) {
                typingTextEl!.textContent += fullText.charAt(charIndex);
                charIndex++;
                (window as any).__heroTypingTimeout = setTimeout(
                    typeChar,
                    typingSpeed,
                );
            }
        }

        (window as any).__heroTypingTimeout = setTimeout(typeChar, 300);
    }

    document.addEventListener("astro:page-load", initHero);
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initHero);
    } else {
        initHero();
    }
</script>
