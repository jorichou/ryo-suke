---
---
<nav class="nav-container" id="nav-menu">
    <div class="nav-items">
        <a href="/work">Works</a>
        <a href="/about/">About</a>
        <a href="/news">News</a>
        <a href="/blog/">Blog</a>
    </div>
    <button class="theme-button" id="theme-button" type="button" aria-label="テーマ切り替え">
        <!-- 太陽アイコン (ライトモード時表示) -->
        <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 32 32">
            <path fill="currentColor" d="M15 3v5h2V3zM7.5 6.094L6.094 7.5l3.531 3.563l1.438-1.438zm17 0l-3.563 3.531l1.438 1.438L25.906 7.5zM16 9c-3.855 0-7 3.145-7 7s3.145 7 7 7s7-3.145 7-7s-3.145-7-7-7m0 2c2.773 0 5 2.227 5 5s-2.227 5-5 5s-5-2.227-5-5s2.227-5 5-5M3 15v2h5v-2zm21 0v2h5v-2zM9.625 20.938L6.094 24.5L7.5 25.906l3.563-3.531zm12.75 0l-1.438 1.437l3.563 3.531l1.406-1.406zM15 24v5h2v-5z"/>
        </svg>
        <!-- 月アイコン (ダークモード時表示) -->
        <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 32 32">
            <path fill="currentColor" d="M5 5v2H3v2h2v2h2V9h2V7H7V5zm15.281 2.938L18.625 8C13.281 8.191 9 12.578 9 17.969c0 5.511 4.488 10 10 10c5.39 0 9.777-4.282 9.969-9.625l.062-1.625l-1.468.687A5.94 5.94 0 0 1 25 17.97c-3.324 0-6-2.676-6-6c0-.914.223-1.75.594-2.531zm-2.906 2.375c-.125.554-.375 1.062-.375 1.656c0 4.406 3.594 8 8 8c.605 0 1.121-.246 1.688-.375c-.762 3.625-3.829 6.375-7.688 6.375c-4.43 0-8-3.57-8-8c0-3.852 2.758-6.887 6.375-7.657z"/>
        </svg>
    </button>
</nav>

<style>
    .nav-container {
        display: flex;
        align-items: center;
        font-family: var(--font-family-en);
    }

    .nav-items {
        display: flex;
        align-items: center;
    }

    .nav-items a {
        text-decoration: none;
        font-weight: 580;
        color: #212122;
        transition: color 0.25s ease;
    }

    .nav-items a:hover {
        color: #e86b79;
    }

    .theme-button {
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0.4rem;
        border-radius: 50%;
        color: #212121;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s ease, background-color 0.2s ease, transform 0.15s ease;
    }

    .theme-button:hover {
        color: #e86b79;
        background-color: rgba(0, 0, 0, 0.05);
    }

    .theme-button:active {
        transform: scale(0.92);
    }

    .theme-button svg {
        display: block;
        width: 1.6rem;
        height: 1.6rem;
    }

    /* ライトモード時: 太陽を表示、月を非表示 */
    .theme-button .sun-icon {
        display: block;
    }

    .theme-button .moon-icon {
        display: none;
    }

    /* ダークモード時 */
    :global(html.dark) .nav-items a {
        color: #ffffff;
    }

    :global(html.dark) .nav-items a:hover {
        color: #ff8a98;
    }

    :global(html.dark) .theme-button {
        color: #ffffff;
    }

    :global(html.dark) .theme-button:hover {
        color: #ff8a98;
        background-color: rgba(255, 255, 255, 0.12);
    }

    :global(html.dark) .theme-button .sun-icon {
        display: none;
    }

    :global(html.dark) .theme-button .moon-icon {
        display: block;
    }

    /* スマホ表示 (< 1024px) */
    @media screen and (max-width: 1023px) {
        .nav-container {
            flex-direction: column;
            width: 100%;
            padding: 0.5rem 0 1.2rem;
            gap: 0.3rem;
        }

        .nav-items {
            flex-direction: column;
            width: 100%;
            align-items: flex-end;
        }

        .nav-items a {
            display: block;
            /* width: 100%; */
            text-align: center;
            padding: 0.75rem 0;
            font-size: 1.2rem;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        :global(html.dark) .nav-items a {
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        }

        .theme-button {
            margin-top: 0.8rem;
            padding: 0.5rem;
            align-self: flex-end;
        }
    }

    /* PC表示 (>= 1024px) */
    @media screen and (min-width: 1024px) {
        .nav-container {
            flex-direction: row;
            gap: 1.2rem;
        }

        .nav-items {
            flex-direction: row;
            gap: 0.2rem;
        }

        .nav-items a {
            display: inline-block;
            padding: 10px 16px;
            font-size: 1.15rem;
        }
    }
</style>
