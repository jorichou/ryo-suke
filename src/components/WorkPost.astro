---
import Tag from "./Tag.astro";

const { pubyear, img_url, work_type, title, url } = Astro.props;

const year = new Date(pubyear).getFullYear();
// const year = pubyear;
---

<style>
    li {
        /* margin: 0; */
        /* margin-top: 10vh; */
        /* width: calc((100% - 6rem) / 4); */
        /* transition: box-shadow 0.5s; */
        border: 1px solid #212121;
        border-radius: 8px;
        transition: border-color 0.25s ease, outline-color 0.25s ease;
        outline: 1px solid transparent;
        overflow: hidden;
    }

    .work-item {
        position: relative;
    }

    /* li:hover {
        
        box-shadow:0 0 10px rgba(232, 107, 121, 1)
    } */

    /* .img-container:hover {
        box-shadow: none;
    } */


    a {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
    }

    /* Hover effects */
    /* a:hover .text-content p {
        color: #e86b79;
    }

    a:hover .work-type {
        border-right-color: #e86b79;
    } */


    .img-container {
        aspect-ratio: 4 / 3;
        background-color: #f0f0f0;
        /* box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); */
        /* border: 2px solid #9E9E9E; */
        transition: border-color 0.5s ease;
        /* border-radius: 8px; */
        overflow: hidden;
    }

    li:hover {
        /* box-shadow: 0 0 0 2px rgba(232, 107, 121, 1); */
        border: 1px solid #E86B79;
        outline: 1.5px solid #E86B79;
    }

    .img-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .work-info {
        display: flex;
        flex-direction: row;
        padding: 0.8rem 1.2rem;
    }

    .text-content {
        /* padding: 0.8rem 0; */
        display: flex;
        justify-content: space-between;
        flex-direction: column;
        align-items: left;
    }

    .text-content p {
        font-weight: 400;
        color: #212121;
        /* transition: color 0.5s ease; */
    }

    /* .upper-content {
        display: flex;
        flex-direction: row;
        margin: 0 0 0.7rem 0;
    }

    .upper-content p {
        font-size: 1.0rem;
    } */

    .work-type {
        padding: 0 1vw 0 0;
        margin: 0;
        border-right: solid #707070 2px;
        /* transition: border-right-color 0.5s ease; */
    }

    .year {
        /* padding: 0 0 0 1vw; */
        margin: 0;
        font-size: 1.1rem;
    }

    .title {
        font-size: 1.1rem;
        margin: 0;
    }

    .tag-wrapper {
        position: absolute;
        bottom: 0.8rem;
        right: 1.2rem;
        z-index: 2;
    }

    @media screen and (max-width: 636px) {
        li {
            width: 100%;
        }

        .work-type {
            padding: 0 3vw 0 0;
        }

        .year {
            /* padding: 0 0 0 3vw; */
        }
    }

    @media screen and (min-width: 636px) and (max-width: 1024px) {
        li {
            /* width: calc((100% - 2rem) / 2); */
        }

        .work-type {
            padding: 0 2vw 0 0;
        }

        .year {
            /* padding: 0 0 0 2vw; */
        }
    }
</style>

<li class="work-item" data-type={work_type}>
    <a href={url}>
        <div class="img-container">
            <img src={img_url} alt={`Image for ${title}`}>
        </div>
        <div class="work-info">
            <div class="text-content">
                <!-- <div class="upper-content">
                    <p class="work-type upper-item">{work_type}</p>
                </div> -->
                <p class="title">{title}</p>
                <p class="year">{year}</p>
            </div>
            <div class="tag-wrapper">
                <Tag tagName={work_type}/>
            </div>
        </div>
    </a>
</li>