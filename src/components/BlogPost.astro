---
import Tag from "./Tag.astro";

const { postDate, img_url, title, url, janre } = Astro.props;

// A simple date formatter
const formattedDate = new Date(postDate).toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
})
---
<style>
li {
    background: #f5f5f5;
    border-radius: 8px;
    /* box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); */
    border: 1px solid #212121;
    /* margin: 1.5rem 0; */
    overflow: hidden; /* This is key for the child's rounded corners to be visible */
    /* transition: transform 0.2s ease-in-out; */
    transition: border-color 0.25s, outline-color 0.25s;

}

li:hover {
    /* transform: translateY(-5px); */
    /* box-shadow:0 0 0 2px rgba(232, 107, 121, 1) */
    border: 1px solid #E86B79;
    outline: 1px solid #E86B79;
}

a {
    display: flex;
    text-decoration: none;
    color: inherit;
    height: clamp(6rem, 20vh, 8rem);
}

.img-container {
    aspect-ratio: 4 / 3; /* Sets a 16:9 aspect ratio */
    background-color: #f0f0f0; /* Placeholder color */
    border-right: 1px solid #9E9E9E;
}

.img-container img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* This makes the image cover the container, cropping it */
}

.blog-info {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 1.7rem 2rem;
}

.text-content {
    /* padding: 1.7rem; */
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    height: 100%;
    /* gap: 4px; */
}

/* .title-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.5rem;
    height: 100%;
} */

.date {
    font-size: 1.1rem;
    font-weight: 400;
    color: #212121;
    margin: 0;
}

.title {
    font-size: 1.1rem;
    font-weight: 400;
    /* margin: 0.5rem 0 0 0; */
    color: #212121;
    /* gap: 2px; */
    margin: 0;
}

html.dark li p {
    color: #f5f5f5;
}

html.dark li {
    background-color: #212121;
    border: 1px solid #f5f5f5;
    transition: border-color 0.25s;
;
}

html.dark li:hover {
    border: 1px solid #E86B79;
}

@media screen and (max-width: 636px) {

    a {
        height: 12vh;
    }

    .img-container {
        aspect-ratio: 1 / 1;
    }

    .blog-info {
        flex-direction: column;
        align-items: flex-start;
        padding: 0 1.5rem;
        padding: 0.8rem 1rem;
    }

    .text-content {
        /* padding: 2vw 0; */
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        gap: 4px;
    }

    .date {
        font-size: 0.8rem;
        margin: 0;
    }

    .title {
        font-size: 0.8rem;
        margin: 0;
    }

    .tag-wrapper {
        /* align-self: flex-end; */
    }

}
</style>

<li>
    <a href={url}>
        <div class="img-container">
            <img src={img_url} alt={`Image for ${title}`} />
        </div>
        <div class="blog-info">
            <div class="text-content">
                <p class="date">{formattedDate}</p>
                <p class="title">{title}</p>
            </div>
            <div class="tag-wrapper">
                <Tag tagName={janre} />
            </div>
        </div>
    </a>
</li>
