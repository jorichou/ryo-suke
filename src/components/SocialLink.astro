---
const {platformURL, platformName} = Astro.props;
---

<style>
    li {
        background-color: #f5f5f5;
        border-radius: 8px;
        /* box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); */
        border: 1px solid #212121;
        width: 100%;
        transition: border-color 0.25s ease, outline-color 0.25s ease;
        outline: 1px solid transparent;
    }

    html.dark li {
        background-color: #212121;
        border: 1px solid #f5f5f5;
        transition: border-color .2 ease;
    }

    li:hover {
        border: 1px solid #E86B79;
        outline: 1.5px solid #E86B79;
        transition: .2;
    }   

    html.dark li:hover {
        border: 1px solid var(--theme-color-dark);
        outline: 1.5px solid var(--theme-color-dark);
        transition: .2s;
    }

    .link-item {
        display: flex;
        text-decoration: none;
        justify-content: space-between;
        align-items: center;
        height: clamp(80px, 8vh, 100px);
        padding: 0.7rem 1.5rem;
    }

    .link-item svg {
        transition: .2s;
    }

    .link-item path {
        fill: #212121;
    }

    html.dark .link-item path {
        fill: #f5f5f5;
    }

    li:hover .link-item svg{
        animation: arrow-bounce .4s ease-in-out;
        /* color: #E86B79; */
    }

    li:hover .link-item path {
        fill: #E86B79;
    }

    html.dark li:hover .link-item path {
        fill: var(--theme-color-dark);
    }

    @keyframes arrow-bounce {
        0% {
            transform: translate(0, 0);
        }
        50% {
            transform: translate(4px, -4px);
        }
        100% {
            transform: translate(0, 0);
        }
    }

    .platform-name {
        color: #212121;
        font-weight: 400;
        font-size: 1.5rem;
        font-family: var(--font-family-en);
    }

    html.dark .link-item .platform-name {
        color: #f5f5f5;
    }
</style>

<li>
    <a href={platformURL} class="link-item" target="_blank">
        <p class="platform-name">{platformName}</p>
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"><!-- Icon from Material Symbols by Google - https://github.com/google/material-design-icons/blob/master/LICENSE --><path fill="currentColor" d="M6.4 18L5 16.6L14.6 7H6V5h12v12h-2V8.4z"/></svg>
    </a>
</li>