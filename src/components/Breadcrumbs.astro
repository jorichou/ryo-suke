---
interface Props {
  title?: string;
  newsTitle?: string;
  items?: Array<{ label: string; href?: string }>;
}

const { title: propTitle, newsTitle, items: customItems } = Astro.props;
const currentTitle = propTitle || newsTitle;

// セグメントに対するラベル・一覧ページへのリンク先マッピング
const segmentMap: Record<string, { label: string; href: string }> = {
  news: { label: "News", href: "/news" },
  posts: { label: "Blog", href: "/blog" },
  blog: { label: "Blog", href: "/blog" },
  works: { label: "Works", href: "/work" },
  work: { label: "Works", href: "/work" },
  about: { label: "About", href: "/about" },
  tags: { label: "Tag", href: "/tags" },
};

// URLからパンくずリストを自動生成
const { pathname } = Astro.url;
const segments = pathname.split("/").filter(Boolean);


interface BreadcrumbItem {
  label: string;
  href?: string;
}

let breadcrumbs: BreadcrumbItem[] = [];

if (customItems && customItems.length > 0) {
  breadcrumbs = customItems;
} else {
  breadcrumbs.push({ label: "Home", href: "/" });

  segments.forEach((segment, index) => {
    const isLast = index === segments.length - 1;
    const lower = segment.toLowerCase();

    if (isLast) {
      // 最終階層は現在地（リンクなし）
      const label = currentTitle || segmentMap[lower]?.label || decodeURIComponent(segment).replace(/-/g, " ");
      breadcrumbs.push({ label });
    } else {
      // 中間階層
      if (segmentMap[lower]) {
        breadcrumbs.push({
          label: segmentMap[lower].label,
          href: segmentMap[lower].href,
        });
      } else {
        const href = "/" + segments.slice(0, index + 1).join("/");
        const formatted = decodeURIComponent(segment).replace(/-/g, " ");
        const label = formatted.charAt(0).toUpperCase() + formatted.slice(1);
        breadcrumbs.push({ label, href });
      }
    }
  });
}
---

<nav aria-label="パンくずリスト" class="breadcrumbs-nav">
  <ol class="breadcrumbs" itemscope itemtype="https://schema.org/BreadcrumbList">
    {
      breadcrumbs.map((item, index) => {
        const isLast = index === breadcrumbs.length - 1;
        return (
          <li
            class:list={["breadcrumb-item", { current: isLast }]}
            itemprop="itemListElement"
            itemscope
            itemtype="https://schema.org/ListItem"
          >
            {isLast ? (
              <span itemprop="name" aria-current="page" class="breadcrumb-current">
                {item.label}
              </span>
            ) : (
              <a href={item.href} itemprop="item" class="breadcrumb-link">
                <span itemprop="name">{item.label}</span>
              </a>
            )}
            <meta itemprop="position" content={String(index + 1)} />
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .breadcrumbs-nav {
    width: 100%;
    margin-bottom: 2rem;
    font-size: 0.9rem;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 0.25rem 0;
    line-height: 1.5;
  }

  .breadcrumb-item {
    display: inline-flex;
    align-items: center;
    color: var(--main-color-black);
    font-weight: var(--font-weight-normal);
  }

  .breadcrumb-item:not(:last-child)::after {
    content: "›";
    margin: 0 0.5rem;
    color: #9e9e9e;
    font-weight: normal;
    font-size: 1.1rem;
    line-height: 1;
    font-weight: 500;
  }

  .breadcrumb-link {
    color: #9E9E9E;
    text-decoration: none;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .breadcrumb-link:hover {
    color: #e86b79;
    text-decoration: underline;
  }

  .breadcrumb-current {
    font-weight: var(--font-weight-normal);
    color: var(--main-color-black);
    max-width: 600px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* モバイル対応 */
  @media screen and (max-width: 636px) {
    .breadcrumbs-nav {
      font-size: 0.8rem;
      margin-bottom: 1.5rem;
    }

    .breadcrumb-current {
      max-width: 260px;
    }

    .breadcrumb-item:not(:last-child)::after {
      margin: 0 0.35rem;
    }
  }

  /* ダークモード対応 */
  :global(html.dark) .breadcrumb-item {
    color: #a0a0a0;
  }

  :global(html.dark) .breadcrumb-item:not(:last-child)::after {
    color: #666666;
  }

  :global(html.dark) .breadcrumb-link {
    color: #b8b8b8;
  }

  :global(html.dark) .breadcrumb-link:hover {
    color: #ff8a98;
  }

  :global(html.dark) .breadcrumb-current {
    color: #ffffff;
  }
</style>