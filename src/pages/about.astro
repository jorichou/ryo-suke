---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentFrame from "../components/ContentFrame.astro";
import Card from "../components/Card.astro";

const pageTitle = "About";
const qualifications = [
    {date: "2025/04", title: "基本情報技術者試験", detail: "合格"},
    {date: "2024/07", title: "TOEIC L&R TEST", detail: "620点"},
    {date: "2023/09", title: "普通自動車第一種運転免許", detail: ""}
];
const skillLIst =[
    {name: "Python", icon: "/images/skill-icon/Python-logo-notext.svg", detail: "研究や競技プログラミングで利用しています。大規模データの処理や簡単なアルゴリズムの実装ができます。"},
    {name: "HTML / CSS", icon: "/images/skill-icon/Official_CSS_Logo.svg", detail: "このサイトのようなウェブサイトを制作することができます。"},
    {name: "C++", icon: "/images/skill-icon/ISO_C++_Logo.svg", detail: "簡単なプログラムを組むことができます。競技プログラミングで使えるようにするために勉強中です。"},
    {name: "Astro", icon: "/images/skill-icon/Astro.svg", detail: "このサイトを制作するにあたって利用しました。"},
    {name: "figma", icon: "/images/skill-icon/Figma-logo.svg", detail: "このサイトを制作するにあたって利用しました。簡単なサイトやアプリのデザインをすることができます。"}
];
const actionList = [
    {name: "Research", icon: "/images/action-icon/HealthiconsIntegratedDataAndResearch24px.svg", detail: "卒業研究として、コミュニティQ&Aサービスにおける外部参照の特徴についての研究を行っています。"},
    {name: "Competition", icon: "/images/action-icon/SolarCupBold.svg", detail: "AtCoderという競技プログラミングに毎週参加しています。"},
    {name: "Development", icon: "/images/action-icon/MaterialSymbolsCodeXml.svg", detail: "このサイトの制作を行いました。他にもアプリケーションやシステムの開発に取り組んでいきたいです。"}
]
---

<style>
    .chapter-content.about{
        flex-direction: column;
    }

    .portfolio-container{
        display: flex;
        flex-direction: row;
        justify-content: space-between;
    }

    .left-content {
        position: sticky;
        top: var(--header-height);
        height: fit-content;
        /* max-height: 100vh; */
        flex: 0 0 40%;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1rem 2rem;
    }

    .right-content {
        flex: 1;
        padding: 1rem 2rem;
    }
    
    h1 {
        color: #e86b79;
        font-size: 3rem;
        margin: 0;
    }

    h2 {
        color: #e86b79;
        font-size: 2.5rem;
        margin: 0;
    }

    .skill {
        /* color: #4A90E2; */
        color: var(--skillColor);
        /* font-weight: bold; */
        font-weight: var(--fontWeight);
        text-transform: var(--textCase);
    }

    .introduce-container {
        display: flex;
        flex-direction: row;
        /*justify-content: space-between;*/
        margin: 10vh 0;
    }

    .image-container {
        width: 15vw;
        aspect-ratio: 1 / 1;
        height: auto;
        border: solid var(--main-color-black) 1px;
        border-radius: 50%;
        overflow: hidden;          /* はみ出た部分を円でクリップ */
        flex-shrink: 0;
    }

    .image-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;         /* 縦横比を保ちながらコンテナを埋める */
        display: block;
    }

    .text-container {
        display: flex;
        flex-direction: column;
        margin: 2rem 0 0 0;
        /* margin: 0 0 0 10vw; */
    }

    .dev-header {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .dev-name.about{
        font-size: 2.2rem;
        font-weight: var(--font-weight-semibold);
        /*margin: 0 0 2vh 0;*/
    }

    .dev-status {
        font-size: 0.8rem;
        /* align-self: center; */
        color: #757575;
        font-weight: var(--font-weight-normal);
        margin: 0;
    }

    .intro-text {
        font-size: 0.9rem;
    }

    .portfolio-item {
        margin: 0 0 10vh 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .portfolio-item-name, .hobby-item-name {
        font-size: 2rem;
        font-weight: var(--font-weight-semibold);
        color: var(--main-color-black);
        margin: 0 0 4vh 0;
    }
    
    
    .timeline {
        display: flex;
        flex-direction: column;
        list-style: none;
        /* padding: 1.5rem 0; */
        margin: 0;
        padding: 0;
        gap: 2rem;
        position: relative;
    }
    
    .timeline::before {
        content: '';
        position: absolute;
        left: 10px;
        top: 0.5rem;
        bottom: 0.5rem;
        width: 2px;
        background: var(--theme-color);
        opacity: 0.5;
    }

    .timeline-item {
        display: flex;
        align-items: center;
        position: relative;
        padding: 0 0 0 4rem;
        /* margin-left: 2.5rem; */
        font-size: 1rem;
    }

    .timeline-dot {
        position: absolute;
        left: 5px;
        /* top: 50%; */
        width: 12px;
        height: 12px;
        /* margin: 0 2rem 0 0; */
        border-radius: 50%;
        background: var(--theme-color);
        z-index: 1;
    }

    .timeline-date {
        width: 100px;
        flex-shrink: 0;
        /* margin: 0 2vw 0 3rem; */
        margin-right: 3vw;
        font-variant-numeric: tabular-nums;
        color: var(--main-color-black);
        font-weight: var(--font-weight-normal);
    }

    .timeline-title {
        /* font-size: 1rem; */
        display: flex;
        gap: 1rem;
        font-weight: var(--font-weight-normal);
        color: var(--main-color-black);
        flex-wrap: wrap;
    }
    
    .timeline-detail {
        color: var(--main-color-black);
    }

    .tabs {
        gap: 20vw;
    }
    
    .skill-container {
        /*margin: 0 0 10vh 0;*/
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(clamp(110px, 11vh, 130px), 1fr));
        /* grid-template-columns: repeat(auto-fill, minmax(18vh, 1fr)); */
        grid-template-rows: repeat(auto-fill, minmax(100px, 1fr));
        justify-items: center;
        gap: 1rem;
        width: 100%;
    }

    .portfolio-item-content.action {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        /* max-width: 400px; */
    }


    .action-container {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(3, calc((100% - 6rem) / 3));
        /* grid-template-columns: repeat(auto-fill, minmax(18vh, 1fr)); */
        grid-template-rows: repeat(auto-fill, minmax(100px, 1fr));
        justify-items: center;
        gap: 3rem;
        width: 80%;
    }

    .tab-line {
        border: solid #e86b79 1px;
    }

    .tab-btn {
        padding: 10px 20px;
        cursor: pointer;
        border: none;
        background: #f1f1f1;
        font-weight: bold;
        color: #e86b79;
        width: 14vw;
        height: 9vh;
        font-size: 1.4rem;
    }

    .tab-btn.active {
        background: #e86b79;
        font-weight: bold;
        color: #ffffff;
    }

    .tab-content {
        display: none;
    }
    
    .tab-content img {
        height: 12vh;
        margin: 4vh 0;
    }

    .tab-content.active {
        display: block;
    }
    
    /* ul, ol {
      padding: 0;
      position: relative;
    } */
    

    .tab-content {
        overflow-x: scroll;
    }

    /* モーダル本体のスタイル */
    .modal {
        padding: 0;
        border: none;
        border-radius: 16px;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.2);
        max-width: 480px;
        width: 90%;
        position: fixed;
        /* showModal() を使うと自動で画面中央に配置されます */
    }
    /* モーダルの背景（オーバーレイ）のスタイル */
    .modal::backdrop {
        background-color: rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(4px); /* 背景をぼかす */
    }
    .modal-content {
        position: relative;
        padding: 2.5rem 2rem 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }
    .modal-close {
        position: absolute;
        top: 1rem;
        right: 1.2rem;
        background: none;
        border: none;
        font-size: 1.8rem;
        cursor: pointer;
        color: #757575;
        line-height: 1;
    }
    .modal-close:hover {
        color: #000;
    }
    .modal-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    .modal-header img {
        width: 80px;
        height: 80px;
        object-fit: contain;
    }
    .modal-header h3 {
        font-size: 1.8rem;
        margin: 0;
        font-weight: var(--font-weight-semibold);
        color: var(--main-color-black);
    }
    .modal-detail {
        font-size: 0.9rem;
        font-weight: var(--font-weight-normal);
        line-height: 1.6;
        color: var(--main-color-black);
        margin: 0;
    }

    @media screen and (max-width: 950px) {
        .portfolio-container {
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .left-content {
            position: inherit;
            margin-bottom: clamp(40px, 1em, 50px);
            /* padding: 1rem 0; */
        }

        .right-content {
            padding: 1rem 0;
            width: 100%;
        }

        .intro-text {
            font-size: 0.9rem;
        }

        .image-container {
            width: 40vw;
            height: 40vw;
        }

        .text-container {
            align-items: center;
        }

        .dev-header {
            justify-content: center;
            align-items: center;
            margin: 1rem 0;
        }

        .dev-name {
            /* font-size: 2.; */
            width: fit-content;
            display: inline-block;
            /* margin: 4vh 0; */
        }

        .text-container {
            margin: 0;
        }

        .timeline-title {
            gap: 0.5rem;
        }

        .tab-btn {
            width: 26vw;
            height: 7vh;
            font-size: .8rem;
            padding: 2vw;
        }


        .tab-content img {
            height: 10vh;
        }
    }

    @media screen and (min-width: 637px) and (max-width: 1023px) {
        .tab-btn {
            width: 26vw;
            /* height: 8vh; */
            font-size: 2vw;
            padding: 0.5em;
        }
    }
</style>

