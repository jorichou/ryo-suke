---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout pageTitle="404 Not Found">
    <section class="not-found" aria-labelledby="not-found-title">
        <a class="not-found-logo" href="/" aria-label="ホームへ戻る">
            <img src="/umekabuto.svg" alt="" />
        </a>
        <div class="not-found-message">
            <h1 id="not-found-title">404 Not Found</h1>
            <p>お探しのページは見つかりませんでした。</p>
        </div>
    </section>
</BaseLayout>

<style>
    .not-found {
        display: grid;
        grid-template-columns: 2fr 3fr;
        align-items: center;
        justify-items: center;
        gap: clamp(2rem, 6vw, 6rem);
        min-height: min(68vh, 720px);
        padding: 3rem 0;
    }

    .not-found-logo {
        display: block;
        width: min(100%, 200px);
        line-height: 0;
    }

    .not-found-logo img {
        display: block;
        width: 100%;
        height: auto;
    }

    .not-found-message {
        text-align: center;
    }

    .not-found-message h1 {
        margin: 0 0 1rem;
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 700;
        line-height: 1.15;
    }

    .not-found-message p {
        margin: 0;
        font-size: 1rem;
    }

    @media (max-width: 636px) {
        .not-found {
            grid-template-columns: 1fr;
            align-content: center;
            gap: 2rem;
            min-height: 60vh;
            padding: 3rem 0;
        }

        .not-found-logo {
            width: min(62vw, 180px);
        }
    }
</style>
